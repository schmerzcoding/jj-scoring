# Use the Project URL from Supabase → Settings → API (NOT the /rest/v1 path)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — required for Stripe webhooks (Supabase → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to "true" when Brevo + custom domain + Supabase Confirm email are ready
NEXT_PUBLIC_REQUIRE_EMAIL_VERIFICATION=false

# Local dev: omit or set to http://localhost:3000 so Stripe returns here after checkout
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (use test keys in development)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
